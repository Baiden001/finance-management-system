# Ash Elite Enterprise deployment — its OWN Supabase project. Placeholders only; never commit real values.
NEXT_PUBLIC_COMPANY=ashelite
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ASHELITE-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-ashelite-anon-key
# Enforce TOTP MFA (aal2) for every session. Strongly recommended for production.
REQUIRE_MFA=true
# Optional: address of the OTHER company's own deployment (adds a "Switch company" link; shares nothing).
NEXT_PUBLIC_OTHER_COMPANY_URL=https://your-resilience-deployment.example
# --- Admin scripts ONLY (db:apply, admin:create). Never set these on the web deployment. ---
