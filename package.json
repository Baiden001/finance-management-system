{
  "name": "finance-management-system",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:resilience": "cp .env.resilience.local .env.local && next dev -p 3001",
    "dev:ashelite": "cp .env.ashelite.local .env.local && next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:apply": "node scripts/apply-migrations.mjs",
    "db:prepare": "node scripts/prepare-supabase-dir.mjs",
    "db:seed": "node scripts/apply-migrations.mjs --seed-only",
    "admin:create": "node scripts/create-accountant.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "exceljs": "^4.4.0",
    "next": "^15.1.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
